{
  "name": "trivia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Game-show trivia with USB buzzers, a cinema-scale display and a host console. Runs on Cloudflare Workers.",
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "validate": "tsx scripts/build-content.ts --check",
    "build": "npm run content && vite build",
    "dev": "npm run build && wrangler dev",
    "dev:watch": "npm run content && (vite build --watch & wrangler dev)",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run content && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "npm run content && vitest run",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "preact": "^10.29.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.20.5",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.0"
  }
}
